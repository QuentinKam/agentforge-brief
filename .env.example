# AgentForge 环境变量示例（复制为 .env 后填写真实值，.env 不入 Git）

# 数据库
DATABASE_URL=postgres://localhost:5432/agentforge

# JWT 密钥（生产请使用足够强度的随机串，例如 `openssl rand -hex 32`）
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# 端口
PORT=3000

# AI Provider（至少配置一个；Playground 用其发起调用）
# OpenAI 兼容 API（可指向本地或第三方 OpenAI 兼容端点）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest
